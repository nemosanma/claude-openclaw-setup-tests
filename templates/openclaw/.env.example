# Copy to ~/.openclaw/.env (chmod 600) or export in your shell profile.
# NEVER commit the real file. Rotate any value you ever pasted into a chat.

# Random 64-hex-char token protecting the Gateway (generate: scripts/gen-gateway-token.sh)
OPENCLAW_GATEWAY_TOKEN=

# Model provider — pay-as-you-go API key from https://platform.claude.com (set a monthly spend limit there!)
ANTHROPIC_API_KEY=

# Telegram bot token from @BotFather (only if you use the Telegram template)
TELEGRAM_BOT_TOKEN=
